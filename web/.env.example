ICAL_URLS="https://example.com/calendar1.ics,https://example.com/calendar2.ics"
NEXT_PUBLIC_LODGIFY_CHECKOUT_URL="https://checkout.lodgify.com/your-reservation"
NEXT_PUBLIC_LODGIFY_CURRENCY="NOK"
LODGIFY_BOOKING_URL="https://your-lodgify-booking-link"
NEXT_PUBLIC_SITE_URL="https://your-production-domain"
LODGIFY_API_KEY="your-rotated-lodgify-api-key"
LODGIFY_PROPERTY_ID="123456"
LODGIFY_ROOM_TYPE_ID="654321"
LODGIFY_API_BASE="https://api.lodgify.com"
RESEND_API_KEY="re_..."
CONTACT_EMAIL_TO="you@example.com"

# CMS. The site is resolved from the request host via `site_domains` — every
# host the site answers on needs a row there, including `localhost` for local
# development (bare host, no port: the lookup strips the port). Without a match
# the request is a 404: this one worker serves every customer domain, so
# rendering the bundled fallback for an unrecognised host would put one
# customer's site under another's domain.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Which site the bundled snapshot in content.generated.ts belongs to.
# `npm run cms:snapshot` prints the line to paste here. Only that site may fall
# back to the snapshot when a document is missing or the CMS is unreachable;
# every other site gets an error instead of someone else's content. Leave unset
# and the snapshot is never used.
CMS_SNAPSHOT_SITE_ID=""

# Sender address for the contact form, on the platform's verified domain. No
# default on purpose — it used to be a customer's own domain, which every other
# site would then have sent its mail from.
EMAIL_FROM_ADDRESS="no-reply@your-verified-domain"

# Server-side key: the domain lookup, per-site config, and the preview's
# unpublished documents (RLS hides all three from the anon key).
SUPABASE_SECRET_KEY="your-secret-key"
